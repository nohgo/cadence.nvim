#!/usr/bin/env python3
"""Offline compiler double; never represents a licensed Cadence validation."""
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

args = sys.argv[1:]


def value(flag):
    return args[args.index(flag) + 1]


source = Path(args[-1])
text = source.read_text()
mode = re.search(r"mode=(\w+)", text).group(1)
trace = value("--trace")
assert Path(value("-cdslib")).is_file()
assert Path(value("-hdlvar")).read_text() == "DEFINE WORK worklib\n"
assert Path("worklib").is_dir()
assert source.is_absolute()
assert value("-work") == "worklib"
assert "-ams" in args
with open(trace, "a") as handle:
    handle.write(json.dumps({"args": args, "cwd": os.getcwd(), "pid": os.getpid()}) + "\n")
if mode == "timeout":
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
if mode == "child":
    subprocess.Popen([sys.executable, "-c", "import time; time.sleep(20)"])
delay = re.search(r"delay=(\d+)", text)
if delay:
    time.sleep(int(delay.group(1)) / 1000)

message = f"xmvlog: *E,TESTERR ({source},2|3): Synthetic source failure.\n"
status = 1
if mode == "clean":
    message, status = "file: " + str(source) + "\nerrors: 0, warnings: 0\n", 0
elif mode == "warning":
    message, status = f"xmvlog: *W,TESTWARN ({source},2|1): Synthetic warning.\n", 0
elif mode == "global":
    message = "xmvlog: *F,NOLICN: Synthetic license checkout failure.\n"
elif mode == "unknown":
    message = "loader: synthetic shared library load failure\n"
elif mode == "include":
    header = Path(value("--header"))
    message = f"xmvlog: *E,HEADER ({header},2|2): Synthetic included-file failure.\n"
elif mode == "relative":
    Path("relative.vah").write_text("// synthetic scratch include\n")
    message = "xmvlog: *E,RELATIVE (relative.vah,1|1): Synthetic relative-path failure.\n"
if mode != "stderr":
    Path(value("-logfile")).write_text(message)
if mode != "logonly":
    print(message, end="", file=sys.stderr if mode == "stderr" else sys.stdout)
sys.exit(status)
